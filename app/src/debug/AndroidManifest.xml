<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
            Debug commands from the adb shell (REWRITE §6.0.3). Exported, but only a sender holding
            DUMP may reach it: the adb shell has that permission, other apps do not.
        -->
        <receiver
            android:name="app.melogold.android.debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">

            <intent-filter>
                <action android:name="app.melogold.android.debug.CMD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
